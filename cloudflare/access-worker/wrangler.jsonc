{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exgenesis-access-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "0 0 1 2,4,6,8,10,12 *"
    ]
  },
  "ratelimits": [
    {
      "name": "ACCESS_REDEEM_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "voes-a88f4"
  },
  "secrets": {
    "required": [
      "ACCESS_KEY_PEPPER",
      "ACCESS_KEY_ENCRYPTION_KEY",
      "ACCESS_ADMIN_TOKEN",
      "FIREBASE_CLIENT_EMAIL",
      "FIREBASE_PRIVATE_KEY",
      "PATREON_CLIENT_ID",
      "PATREON_CLIENT_SECRET",
      "PATREON_REDIRECT_URI",
      "PATREON_WEBHOOK_SECRET",
      "RESEND_API_KEY",
      "ACCESS_EMAIL_FROM"
    ]
  }
}
