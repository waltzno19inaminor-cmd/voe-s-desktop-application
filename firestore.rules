rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isReplyLikeCounterUpdate(replyId) {
      let likePath = /databases/$(database)/documents/replies/$(replyId)/likes/$(request.auth.uid);

      return isSignedIn()
        && resource.data.likes is int
        && request.resource.data.likes is int
        && request.resource.data.likes >= 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likes"])
        && (
          (!exists(likePath)
            && existsAfter(likePath)
            && request.resource.data.likes == resource.data.likes + 1)
          || (exists(likePath)
            && !existsAfter(likePath)
            && request.resource.data.likes == resource.data.likes - 1)
        );
    }

    function isThreadLikeCounterUpdate(threadId) {
      let likePath = /databases/$(database)/documents/users/$(request.auth.uid)/likedThreads/$(threadId);
      let storedLikes = resource.data.get("likesCount", 0);
      let currentLikes = storedLikes is number && storedLikes > 0 ? storedLikes : 0;

      return isSignedIn()
        && storedLikes is number
        && request.resource.data.likesCount is number
        && request.resource.data.likesCount >= 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likesCount"])
        && (
          (!exists(likePath)
            && existsAfter(likePath)
            && request.resource.data.likesCount == currentLikes + 1)
          || (exists(likePath)
            && !existsAfter(likePath)
            && currentLikes > 0
            && request.resource.data.likesCount == currentLikes - 1)
        );
    }

    function normalizedThreadLikes(threadId) {
      let storedLikes = get(/databases/$(database)/documents/threads/$(threadId)).data.get("likesCount", 0);
      return storedLikes is number && storedLikes > 0 ? storedLikes : 0;
    }

    match /users/{userId} {
      // Leaderboard needs public profile fields (displayName/photoURL) for signed-in users.
      // Writes remain restricted to the profile owner below.
      allow read: if isSignedIn();

      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny([
          "type",
          "expiresAt",
          "updatedAt"
        ]);

      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "type",
          "expiresAt",
          "updatedAt"
        ]);

      allow delete: if false;
    }

    match /users/{userId}/{subcollection}/{docId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && subcollection != "likedThreads"
        && subcollection != "notifications";
      allow delete: if false;
    }

    match /users/{userId}/likedThreads/{threadId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(["likedAt", "threadId"])
        && request.resource.data.threadId == threadId
        && request.resource.data.likedAt == request.time
        && getAfter(/databases/$(database)/documents/threads/$(threadId)).data.likesCount
          == normalizedThreadLikes(threadId) + 1;

      allow delete: if isOwner(userId)
        && resource.data.threadId == threadId
        && getAfter(/databases/$(database)/documents/threads/$(threadId)).data.likesCount
          == (normalizedThreadLikes(threadId) > 0 ? normalizedThreadLikes(threadId) - 1 : 0);

      allow update: if false;
    }

    match /users/{userId}/notifications/{notificationId} {
      // A recipient may see notifications addressed only to them.
      allow read: if isOwner(userId);

      // Forum reply notifications may be emitted by the author of a reply only
      // to the actual author of the replied-to message. System, tournament and
      // leaderboard notifications are written by a trusted backend (Admin SDK).
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
          "type",
          "content",
          "createdAt",
          "isRead",
          "actorId",
          "target"
        ])
        && request.resource.data.keys().hasOnly([
          "type",
          "content",
          "createdAt",
          "isRead",
          "actorId",
          "actorLabel",
          "target",
          "context"
        ])
        && request.resource.data.type == "reply_to_you"
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.isRead == false
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.target.entity == "reply"
        && request.resource.data.target.id is string
        && get(/databases/$(database)/documents/replies/$(request.resource.data.target.id)).data.authorId == userId;

      // Reading is intentionally one-way: the client cannot modify content or
      // turn an already read notification back into an unread notification.
      allow update: if isOwner(userId)
        && resource.data.isRead == false
        && request.resource.data.isRead == true
        && request.resource.data.readAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "isRead",
          "readAt"
        ]);

      allow delete: if false;
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if false;

      match /participants/{userId} {
        allow read: if isSignedIn();

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll([
            "userId",
            "registeredAt",
            "serverTimeSyncAt",
            "status"
          ])
          && request.resource.data.keys().hasOnly([
            "userId",
            "userEmail",
            "registeredAt",
            "serverTimeSyncAt",
            "status"
          ])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == "active"
          && request.resource.data.registeredAt == request.time
          && request.resource.data.serverTimeSyncAt == request.time;

        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "serverTimeSyncAt"
          ])
          && request.resource.data.serverTimeSyncAt == request.time;

        allow delete: if false;
      }

      match /seasons/{seasonId} {
        allow read: if isSignedIn();
        allow create, update, delete: if false;

        match /leaderboard/{userId} {
          // Participants may read the leaderboard, but only create their own
          // initial zero-score entry during tournament registration.
          allow read: if isSignedIn();

          allow create: if isOwner(userId)
            && request.resource.data.keys().hasAll([
              "userId",
              "points",
              "totalPredictions",
              "correctPredictions",
              "createdAt"
            ])
            && request.resource.data.keys().hasOnly([
              "userId",
              "points",
              "totalPredictions",
              "correctPredictions",
              "createdAt"
            ])
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.points == 0
            && request.resource.data.totalPredictions == 0
            && request.resource.data.correctPredictions == 0
            && request.resource.data.createdAt == request.time;

          // Points and results must be updated by a trusted backend process.
          allow update, delete: if false;
        }

        match /rounds/{roundId} {
          allow read: if isSignedIn();
          allow create, update, delete: if false;

          function roundData() {
            return get(
              /databases/$(database)/documents
              /tournaments/$(tournamentId)
              /seasons/$(seasonId)
              /rounds/$(roundId)
            ).data;
          }

          function votingIsOpen() {
            let round = roundData();

            return round.startsAt is timestamp
              && round.endsAt is timestamp
              && request.time >= round.startsAt
              && request.time < round.endsAt
              && round.status == "opened";
          }

          match /predictions/{predictionId} {
            // Соотношение LONG/SHORT видно всем авторизованным участникам во время голосования.
            // Создание и изменение прогнозов остаётся доступным только их владельцу.
            allow read: if isSignedIn();

            allow create: if isSignedIn()
              && votingIsOpen()
              && predictionId == request.auth.uid + "_" + request.resource.data.assetId
              && request.resource.data.keys().hasAll([
                "userId",
                "assetId",
                "asset",
                "predict",
                "predictTime"
              ])
              && request.resource.data.keys().hasOnly([
                "userId",
                "assetId",
                "asset",
                "predict",
                "predictTime"
              ])
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.assetId is string
              && request.resource.data.asset is string
              && request.resource.data.predict in ["LONG", "SHORT"]
              && request.resource.data.predictTime == request.time;

            allow update: if isSignedIn()
              && votingIsOpen()
              && resource.data.userId == request.auth.uid
              && request.resource.data.userId == resource.data.userId
              && request.resource.data.assetId == resource.data.assetId
              && request.resource.data.asset == resource.data.asset
              && request.resource.data.keys().hasOnly([
                "userId",
                "assetId",
                "asset",
                "predict",
                "predictTime"
              ])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "predict",
                "predictTime"
              ])
              && request.resource.data.predict in ["LONG", "SHORT"]
              && request.resource.data.predictTime == request.time;

            allow delete: if false;
          }
        }
      }
    }

    match /threads/{threadId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.get("likesCount", 0) is number
        && request.resource.data.get("likesCount", 0) >= 0;
      allow update: if isSignedIn()
        && (
          (resource.data.authorId == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["likesCount"]))
          || isThreadLikeCounterUpdate(threadId)
        );
      allow delete: if false;
    }

    match /replies/{replyId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;

      allow update: if isSignedIn()
        && (
          resource.data.authorId == request.auth.uid
          || isReplyLikeCounterUpdate(replyId)
        );

      allow delete: if false;

      match /likes/{userId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(["createdAt"])
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/replies/$(replyId)).data.likes == get(/databases/$(database)/documents/replies/$(replyId)).data.likes + 1;

        allow update: if false;

        allow delete: if isOwner(userId)
          && getAfter(/databases/$(database)/documents/replies/$(replyId)).data.likes == get(/databases/$(database)/documents/replies/$(replyId)).data.likes - 1;
      }
    }
  }
}
